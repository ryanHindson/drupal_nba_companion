    <span aria-hidden="true">←</span>
    <span>Back</span>
  </a>

  <a class="nba-nav__brand" href="{{ home_url }}">
    NBA Companion
  </a>

  <div class="nba-nav__actions">

    <details class="nba-nav__search">
      <summary
        class="nba-nav__button nba-nav__search-toggle"
